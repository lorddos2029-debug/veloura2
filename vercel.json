{
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/index?scope=admin&route=:route*"
    },
    {
      "source": "/api/pix/:route*",
      "destination": "/api/index?route=:route*"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/pix",
      "destination": "/pix/index.html"
    },
    {
      "source": "/pix/",
      "destination": "/pix/index.html"
    },
    {
      "source": "/kit",
      "destination": "/kit/index.html"
    },
    {
      "source": "/kit/",
      "destination": "/kit/index.html"
    },
    {
      "source": "/calca",
      "destination": "/calca/index.html"
    },
    {
      "source": "/calca/",
      "destination": "/calca/index.html"
    },
    {
      "source": "/legging",
      "destination": "/legging/index.html"
    },
    {
      "source": "/legging/",
      "destination": "/legging/index.html"
    },
    {
      "source": "/bolsa",
      "destination": "/bolsa/index.html"
    },
    {
      "source": "/bolsa/",
      "destination": "/bolsa/index.html"
    },
    {
      "source": "/painel",
      "destination": "/painel/index.html"
    },
    {
      "source": "/painel/",
      "destination": "/painel/index.html"
    },
    {
      "source": "/escova",
      "destination": "/escova/index.html"
    },
    {
      "source": "/escova/",
      "destination": "/escova/index.html"
    }
  ],
  "headers": [
    {
      "source": "/painel/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
